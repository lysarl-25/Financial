VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

SUPABASE_SERVICE_ROLE_KEY = <your-service-role-key>
# Edge Functions require SUPABASE_SERVICE_ROLE_KEY to be set in your Supabase project.
# This is configured via the Supabase Dashboard > Edge Functions > Secrets.
# Do NOT expose the service role key in client-side code.
